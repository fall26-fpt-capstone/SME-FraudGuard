@startuml
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam ArrowThickness 1
skinparam classAttributeIconSize 0
skinparam classBackgroundColor white
skinparam classBorderColor #777777
skinparam classBorderThickness 1
skinparam classFontSize 12
skinparam classAttributeFontSize 11
skinparam stereotypeFontSize 10
skinparam Padding 4
hide circle
skinparam sequenceMessageAlign left
skinparam sequenceMessageFontSize 11
skinparam sequenceParticipantFontSize 11
skinparam sequenceParticipantBackgroundColor white
skinparam sequenceParticipantBorderColor #777777
skinparam sequenceLifeLineBorderColor #999999
skinparam sequenceLifeLineBackgroundColor white
skinparam sequenceActivationBorderColor #777777
skinparam sequenceActivationBackgroundColor white
skinparam sequenceActivationBorderThickness 0.5
skinparam sequenceGroupBorderThickness 0.6
skinparam sequenceGroupFontSize 10
skinparam maxMessageSize 290
autonumber

actor "Enterprise User" as User
participant "Transactions / Import Results Page" as UI
participant "TransactionReviewController" as C
participant "ReviewService" as S
participant "TransactionQueryRepository" as R
participant "Database" as DB
User -> UI ++: submit(request)
UI -> C ++: reviewTransactionsOrImport(request)
C -> C: resolveExecutionContext()
C -> S ++: reviewTransactionsOrImport(request, context)
S -> S: authorizeRequestedReview(ctx)
alt authorizedOperatorTransactionView
S -> R ++: findProtectedTransactions(req, ctx)
R -> DB ++: SELECT bounded transaction projection\nWHERE workspace and permitted object scope
DB --> R --: rows / committed result
R --> S --: protectedTransactionPage

else authorizedAdminOrOperatorImportView
S -> R ++: findImportResults(req, ctx)
R -> DB ++: SELECT batch + exclusive row outcomes + pending counts\nWHERE authorized workspace
DB --> R --: rows / committed result
R --> S --: safeImportDetail

else forbiddenRoleOrObject
  S -> S: denyWithoutDisclosure()
end
S --> C --: TransactionReviewResponse / controlled error
C --> UI --: TransactionReviewResponse / safe error
UI --> User --: render permitted result
@enduml
