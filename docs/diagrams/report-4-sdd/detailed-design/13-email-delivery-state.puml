@startuml
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam ArrowThickness 1
skinparam classAttributeIconSize 0
skinparam classBackgroundColor white
skinparam classBorderColor #777777
skinparam classBorderThickness 1
skinparam classFontSize 12
skinparam classAttributeFontSize 11
skinparam stereotypeFontSize 10
skinparam Padding 4
hide circle
skinparam stateBackgroundColor white
skinparam stateBorderColor #222222
skinparam stateFontSize 22
skinparam ArrowFontSize 20
!pragma layout elk
top to bottom direction
hide empty description
skinparam linetype ortho
skinparam nodesep 65
skinparam ranksep 65

state "Pending Delivery" as Pending
state "Sending" as Sending
state "Sent" as Sent
state "Failed" as Failed
state DeliveryOutcome <<choice>>
state DeliveryEnd <<end>>
[*] --> Pending
Pending -down-> Sending : Send configured notification
Sending -down-> DeliveryOutcome : Record provider outcome
DeliveryOutcome -down-> Sent : [send succeeded]
DeliveryOutcome --> Failed : [send or recipient validation failed]
Sent --> DeliveryEnd
Failed --> DeliveryEnd
@enduml
