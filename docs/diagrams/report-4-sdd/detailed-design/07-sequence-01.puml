@startuml
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam ArrowThickness 1
skinparam classAttributeIconSize 0
skinparam classBackgroundColor white
skinparam classBorderColor #777777
skinparam classBorderThickness 1
skinparam classFontSize 12
skinparam classAttributeFontSize 11
skinparam stereotypeFontSize 10
skinparam Padding 4
hide circle
skinparam sequenceMessageAlign left
skinparam sequenceMessageFontSize 11
skinparam sequenceParticipantFontSize 11
skinparam sequenceParticipantBackgroundColor white
skinparam sequenceParticipantBorderColor #777777
skinparam sequenceLifeLineBorderColor #999999
skinparam sequenceLifeLineBackgroundColor white
skinparam sequenceActivationBorderColor #777777
skinparam sequenceActivationBackgroundColor white
skinparam sequenceActivationBorderThickness 0.5
skinparam sequenceGroupBorderThickness 0.6
skinparam sequenceGroupFontSize 10
skinparam maxMessageSize 290
autonumber

actor "Authorized Key Actor" as User
participant "Integration Keys Page" as UI
participant "CredentialController" as C
participant "CredentialService" as S
participant "ApiCredentialRepository" as R
participant "Database" as DB
User -> UI ++: submit(request)
UI -> C ++: manageCredential(request)
C -> C: resolveExecutionContext()
C -> S ++: manageCredential(request, context)
S -> S: authorizeKeyAdministration(ctx)
S -> R ++: findCredentialMetadata(req, ctx)
R -> DB ++: SELECT prefix, status and history only
DB --> R --: rows / committed result
R --> S --: credentialPage

alt issueOrReplaceRequested
  S -> S: requireAdminOrAssignedStaff(ctx)
  S -> S: generateSecretAndVerifier()
S -> R ++: saveNewVerifier(req, ctx)
R -> DB ++: INSERT credential verifier + safe history; COMMIT
DB --> R --: rows / committed result
R --> S --: issuedCredential

  S -> S: discloseNewSecretOnce()
else disableRequested
S -> R ++: disableCredentialIfAllowed(req, ctx)
R -> DB ++: UPDATE disabled state + safe history; COMMIT
DB --> R --: rows / committed result
R --> S --: disabled / alreadyDisabled / failed

end
S --> C --: CredentialResponse / controlled error
C --> UI --: CredentialResponse / safe error
UI --> User --: render permitted result
@enduml
