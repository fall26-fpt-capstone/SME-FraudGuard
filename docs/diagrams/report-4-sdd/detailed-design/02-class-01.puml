class Enterprise <<entity>> {
- id: UUID
- name: String
- contactEmail: String
}
class Workspace <<entity>> {
- id: UUID
- enterpriseId: UUID
- slug: String
- activatedAt: Instant [0..1]
--
+ isActivated(): Boolean
}
class StaffAssignment <<entity>> {
- staffId: UUID
- assignedBy: UUID
- assignedAt: Instant
- endedAt: Instant [0..1]
--
+ end(): boolean
}
class Account <<entity>> {
- id: UUID
- role: Role
- mustChangePassword: Boolean
}
interface WorkspaceRepository <<repository>> {

+ applyAssignmentChanges(req: StaffAssignmentRequest, ctx: AccessContext): MutationResult
+ createWorkspaceAndAdmin(req: ProvisionWorkspaceRequest, ctx: AccessContext): MutationResult
+ findAuthorizedWorkspaces(req: WorkspaceRequest, ctx: AccessContext): Page<Workspace>
+ findCurrentAssignments(req: StaffAssignmentRequest): List<StaffAssignment>
+ findProvisioningConflicts(req: ProvisionWorkspaceRequest): List<ProvisioningConflict>
+ updateMetadataIfCurrent(req: WorkspaceRequest, ctx: AccessContext): MutationResult
}
class AccessContext <<security>> {
- principalId: UUID [0..1]
- workspaceId: UUID [0..1]
- role: Role [0..1]
- verifiedScope: AccessScope
}
class WorkspaceController <<controller>> {
- service: IWorkspaceService
--
+ provisionWorkspace(request: ProvisionWorkspaceRequest): WorkspaceResponse
+ readOrUpdateWorkspace(request: WorkspaceRequest): WorkspaceResponse
+ updateStaffAssignments(request: StaffAssignmentRequest): WorkspaceResponse
- resolveExecutionContext(): AccessContext
}
class WorkspaceService <<service>> {

+ provisionWorkspace(request: ProvisionWorkspaceRequest, context: AccessContext): WorkspaceResponse
+ readOrUpdateWorkspace(request: WorkspaceRequest, context: AccessContext): WorkspaceResponse
+ updateStaffAssignments(request: StaffAssignmentRequest, context: AccessContext): WorkspaceResponse
- authorizeAdministrativeScope(ctx: AccessContext): void
- requirePlatformAdmin(ctx: AccessContext): void
- validateAssignmentChanges(req: StaffAssignmentRequest): void
- validateMetadata(req: WorkspaceRequest): void
- validateProvisioning(req: ProvisionWorkspaceRequest): void
}
interface IWorkspaceService <<service>> {

+ provisionWorkspace(request: ProvisionWorkspaceRequest, context: AccessContext): WorkspaceResponse
+ readOrUpdateWorkspace(request: WorkspaceRequest, context: AccessContext): WorkspaceResponse
+ updateStaffAssignments(request: StaffAssignmentRequest, context: AccessContext): WorkspaceResponse
}
class WorkspaceRequest <<DTO>> {
- workspaceId: UUID
- criteria: WorkspaceFilter
- changes: WorkspaceMetadata
- expectedVersion: long
}
class WorkspaceResponse <<DTO>> {
- workspaceId: UUID
- metadata: WorkspaceMetadata
- version: long
}
class ProvisionWorkspaceRequest <<DTO>> {
- enterprise: EnterpriseInput
- workspaceSlug: String
- adminLogin: String
- contactEmail: String
}
class StaffAssignmentRequest <<DTO>> {
- workspaceId: UUID
- additions: Set<UUID>
- removals: Set<UUID>
- expectedVersion: long
}
