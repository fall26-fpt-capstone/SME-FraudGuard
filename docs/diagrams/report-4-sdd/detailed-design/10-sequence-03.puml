@startuml
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam ArrowThickness 1
skinparam classAttributeIconSize 0
skinparam classBackgroundColor white
skinparam classBorderColor #777777
skinparam classBorderThickness 1
skinparam classFontSize 12
skinparam classAttributeFontSize 11
skinparam stereotypeFontSize 10
skinparam Padding 4
hide circle
skinparam sequenceMessageAlign left
skinparam sequenceMessageFontSize 11
skinparam sequenceParticipantFontSize 11
skinparam sequenceParticipantBackgroundColor white
skinparam sequenceParticipantBorderColor #777777
skinparam sequenceLifeLineBorderColor #999999
skinparam sequenceLifeLineBackgroundColor white
skinparam sequenceActivationBorderColor #777777
skinparam sequenceActivationBackgroundColor white
skinparam sequenceActivationBorderThickness 0.5
skinparam sequenceGroupBorderThickness 0.6
skinparam sequenceGroupFontSize 10
skinparam maxMessageSize 290
autonumber

actor "Operator / Assigned Investigator" as User
participant "Authorized Field Reveal" as UI
participant "DisclosureController" as C
participant "DisclosureService" as S
participant "DisclosurePolicy" as P
participant "ProtectedValuePort" as E
participant "TransactionQueryRepository" as R
participant "Database" as DB
User -> UI ++: submit(request)
UI -> C ++: revealFields(request)
C -> C: resolveExecutionContext()
C -> S ++: revealFields(request, context)
S -> P ++: authorizeCurrentDisclosure(req, ctx)
P --> S --: permittedFields / denied

alt currentRoleFieldGrantAndObjectAccess
S -> R ++: findProtectedValues(req, ctx)
R -> DB ++: SELECT authorized encrypted fields + key reference
DB --> R --: rows / committed result
R --> S --: protectedValues
S -> E ++: decryptPermittedFields(req)
E --> S --: authorizedPlaintext / failure
S -> R ++: recordDisclosureAudit(req, ctx)
R -> DB ++: INSERT actor/time/object/field references; COMMIT\nExclude plaintext values
DB --> R --: rows / committed result
R --> S --: auditCommitted / failed

  alt decryptionAndAuditSucceeded
    S -> S: createPermittedDisclosureResponse(req)
  else requiredProcessingFailed
    S -> S: discardPlaintextResponse()
  end
else missingGrantOrAssignment
  S -> S: denyWithoutDisclosure()
end
S --> C --: DisclosureResponse / controlled error
C --> UI --: DisclosureResponse / safe error
UI --> User --: render permitted result
@enduml
