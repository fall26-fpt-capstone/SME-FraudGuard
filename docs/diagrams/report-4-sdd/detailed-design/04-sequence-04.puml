@startuml
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam ArrowThickness 1
skinparam classAttributeIconSize 0
skinparam classBackgroundColor white
skinparam classBorderColor #777777
skinparam classBorderThickness 1
skinparam classFontSize 12
skinparam classAttributeFontSize 11
skinparam stereotypeFontSize 10
skinparam Padding 4
hide circle
skinparam sequenceMessageAlign left
skinparam sequenceMessageFontSize 11
skinparam sequenceParticipantFontSize 11
skinparam sequenceParticipantBackgroundColor white
skinparam sequenceParticipantBorderColor #777777
skinparam sequenceLifeLineBorderColor #999999
skinparam sequenceLifeLineBackgroundColor white
skinparam sequenceActivationBorderColor #777777
skinparam sequenceActivationBackgroundColor white
skinparam sequenceActivationBorderThickness 0.5
skinparam sequenceGroupBorderThickness 0.6
skinparam sequenceGroupFontSize 10
skinparam maxMessageSize 290
autonumber

actor "SME Admin" as User
participant "Workspace Activation Page" as UI
participant "OnboardingController" as C
participant "OnboardingService" as S
participant "SubscriptionPort" as P
participant "OnboardingRepository" as R
participant "Database" as DB
User -> UI ++: submit(request)
UI -> C ++: activateWorkspace(request)
C -> C: resolveExecutionContext()
C -> S ++: activateWorkspace(request, context)
S -> S: requireOwnWorkspaceAdmin(ctx)
S -> R ++: lockActivationState(req, ctx)
R -> DB ++: SELECT workspace + readiness + approval FOR UPDATE
DB --> R --: rows / committed result
R --> S --: activationContext

alt alreadyActivated
  S -> S: reuseActivationResult()
else currentReadinessAndApproval
S -> P ++: prepareInitialTerm(req)
P --> S --: initialTerm / Free
S -> R ++: activateWithInitialTermOnce(req, ctx)
R -> DB ++: UPDATE activation + INSERT initial term + history\nCOMMIT atomically once
DB --> R --: rows / committed result
R --> S --: operational / rolledBack

else unmetOrStaleGate
  S -> S: denyActivation()
end
S --> C --: OnboardingResponse / controlled error
C --> UI --: OnboardingResponse / safe error
UI --> User --: render permitted result
@enduml
