@startuml
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam ArrowThickness 1
skinparam classAttributeIconSize 0
skinparam classBackgroundColor white
skinparam classBorderColor #777777
skinparam classBorderThickness 1
skinparam classFontSize 12
skinparam classAttributeFontSize 11
skinparam stereotypeFontSize 10
skinparam Padding 4
hide circle
skinparam sequenceMessageAlign left
skinparam sequenceMessageFontSize 11
skinparam sequenceParticipantFontSize 11
skinparam sequenceParticipantBackgroundColor white
skinparam sequenceParticipantBorderColor #777777
skinparam sequenceLifeLineBorderColor #999999
skinparam sequenceLifeLineBackgroundColor white
skinparam sequenceActivationBorderColor #777777
skinparam sequenceActivationBackgroundColor white
skinparam sequenceActivationBorderThickness 0.5
skinparam sequenceGroupBorderThickness 0.6
skinparam sequenceGroupFontSize 10
skinparam maxMessageSize 290
autonumber

actor "Validated Production Channel" as User
participant "TransactionAcceptanceHandler" as C
participant "TransactionIngestionService" as S
participant "TransactionEventPublisher" as P
participant "TransactionRepository" as R
participant "Database" as DB
User -> C ++: acceptNormalized(request)
C -> C: resolveExecutionContext()
C -> S ++: acceptNormalized(request, context)
S -> S: resolveAuthoritativeAcceptanceContext(req)
S -> R ++: resolveBusinessIdentityAtomically(req)
R -> DB ++: BEGIN; resolve unique(workspace, externalId)\nand normalized fingerprint
DB --> R --: rows / committed result
R --> S --: identityOutcome

alt equivalentNormalizedContent
  S -> S: returnExistingReference()
else conflictingContent
  S -> S: rejectWithoutOverwriting()
else newBusinessIdentity
S -> R ++: commitTransactionAndReceipt(req)
R -> DB ++: INSERT protected transaction + receipt\n+ selected plan/configuration context; COMMIT
DB --> R --: rows / committed result
R --> S --: acceptedRef / explicitFailure

  opt acceptanceCommitted
S -> P ++: publishTransactionIngested(req)
P --> S --: eventPublished / recoverableDispatchFailure

  end
end
S --> C --: IngestionResult / controlled error
C --> User --: processing result / acknowledgment
@enduml
