@startuml
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam ArrowThickness 1
skinparam classAttributeIconSize 0
skinparam classBackgroundColor white
skinparam classBorderColor #777777
skinparam classBorderThickness 1
skinparam classFontSize 12
skinparam classAttributeFontSize 11
skinparam stereotypeFontSize 10
skinparam Padding 4
hide circle
skinparam sequenceMessageAlign left
skinparam sequenceMessageFontSize 11
skinparam sequenceParticipantFontSize 11
skinparam sequenceParticipantBackgroundColor white
skinparam sequenceParticipantBorderColor #777777
skinparam sequenceLifeLineBorderColor #999999
skinparam sequenceLifeLineBackgroundColor white
skinparam sequenceActivationBorderColor #777777
skinparam sequenceActivationBackgroundColor white
skinparam sequenceActivationBorderThickness 0.5
skinparam sequenceGroupBorderThickness 0.6
skinparam sequenceGroupFontSize 10
skinparam maxMessageSize 290
autonumber

actor "Platform Admin / Staff" as User
participant "Workspaces Page" as UI
participant "WorkspaceController" as C
participant "WorkspaceService" as S
participant "WorkspaceRepository" as R
participant "Database" as DB
User -> UI ++: submit(request)
UI -> C ++: readOrUpdateWorkspace(request)
C -> C: resolveExecutionContext()
C -> S ++: readOrUpdateWorkspace(request, context)
S -> S: authorizeAdministrativeScope(ctx)
S -> R ++: findAuthorizedWorkspaces(req, ctx)
R -> DB ++: SELECT administrative metadata\nWHERE admin scope or active Staff assignment
DB --> R --: rows / committed result
R --> S --: workspacePage

opt metadataUpdateRequested
  S -> S: requirePlatformAdmin(ctx)
  S -> S: validateMetadata(req)
S -> R ++: updateMetadataIfCurrent(req, ctx)
R -> DB ++: UPDATE permitted metadata with version check\n+ INSERT audit; COMMIT
DB --> R --: rows / committed result
R --> S --: updated / stale / invalid
end
S --> C --: WorkspaceResponse / controlled error
C --> UI --: WorkspaceResponse / safe error
UI --> User --: render permitted result
@enduml
