@startuml
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam ArrowThickness 1
skinparam classAttributeIconSize 0
skinparam classBackgroundColor white
skinparam classBorderColor #777777
skinparam classBorderThickness 1
skinparam classFontSize 12
skinparam classAttributeFontSize 11
skinparam stereotypeFontSize 10
skinparam Padding 4
hide circle
skinparam sequenceMessageAlign left
skinparam sequenceMessageFontSize 11
skinparam sequenceParticipantFontSize 11
skinparam sequenceParticipantBackgroundColor white
skinparam sequenceParticipantBorderColor #777777
skinparam sequenceLifeLineBorderColor #999999
skinparam sequenceLifeLineBackgroundColor white
skinparam sequenceActivationBorderColor #777777
skinparam sequenceActivationBackgroundColor white
skinparam sequenceActivationBorderThickness 0.5
skinparam sequenceGroupBorderThickness 0.6
skinparam sequenceGroupFontSize 10
skinparam maxMessageSize 290
autonumber

actor "AI Recovery Worker" as User
participant "RecoveryCoordinator" as C
participant "ScoringService" as S
participant "EntitlementHistoryPort" as H
participant "AIServicePort" as P
participant "AlertCommandPort" as A
participant "DetectionAttemptRepository" as R
participant "Database" as DB
User -> C ++: recoverFallbackTransaction(request)
C -> C: resolveExecutionContext()
C -> S ++: recoverFallbackTransaction(request, context)
S -> H ++: findHistoricalEntitlement(req)
H --> S --: eventTimeEligible / ineligible

alt historicallyEntitledEventTime
S -> R ++: findRecoveryOperation(req)
R -> DB ++: SELECT stored fallback and recovery operation identity
DB --> R --: rows / committed result
R --> S --: existingOperation

  alt operationAlreadyCompleted
    S -> S: reuseRecoveryResult()
  else newOrRetryableOperation
S -> P ++: classify(req)
P --> S --: classification + modelVersion / failure
S -> R ++: appendRecoveryAttempt(req)
R -> DB ++: INSERT separate recovery attempt + original references; COMMIT
DB --> R --: rows / committed result
R --> S --: recoveryAttempt

    alt validAnomaly
S -> A ++: createOrReuseAiAlert(req)
A --> S --: singleTransactionAiAlert

    else normalOrFailed
      S -> S: preserveExistingAlertsAndCases()
    end
  end
else noHistoricalEntitlement
  S -> S: excludeFromRecovery()
end
S --> C --: DetectionResult / controlled error
C --> User --: processing result / acknowledgment
@enduml
