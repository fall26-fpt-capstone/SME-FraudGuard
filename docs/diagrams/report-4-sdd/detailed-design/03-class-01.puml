PurchaseOrder "1" -[norank]- "0..*" PaymentEvent
PurchaseOrderRepository -[norank]-> PurchaseOrder
SubscriptionController -[norank]-> ISubscriptionService
SubscriptionController -[dashed,norank]-> CheckoutResponse
SubscriptionController -[dashed,norank]-> InitialPlanRequest
SubscriptionController -[dashed,norank]-> PlanOfferRequest
SubscriptionController -[dashed,norank]-> PlanOfferResponse
SubscriptionController -[dashed,norank]-> PurchaseRequest
SubscriptionController -[dashed,norank]-> SubscriptionResponse
SubscriptionPeriodRepository -[norank]-> SubscriptionPeriod
SubscriptionRepository -[norank]-> SubscriptionPeriod
SubscriptionService -[norank]-> PaymentGatewayPort
SubscriptionService -[norank]-> PlanRepository
SubscriptionService -[norank]-> PurchaseOrder
SubscriptionService -[norank]-> PurchaseOrderRepository
SubscriptionService -[norank]-> SubscriptionPeriodRepository
SubscriptionService -[norank]-> SubscriptionRepository
SubscriptionService -[dashed,norank]-> AccessContext
SubscriptionService -[dashed,norank]-|> ISubscriptionService
@enduml
