@startuml
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam ArrowThickness 1
skinparam classAttributeIconSize 0
skinparam classBackgroundColor white
skinparam classBorderColor #777777
skinparam classBorderThickness 1
skinparam classFontSize 12
skinparam classAttributeFontSize 11
skinparam stereotypeFontSize 10
skinparam Padding 4
hide circle
skinparam sequenceMessageAlign left
skinparam sequenceMessageFontSize 11
skinparam sequenceParticipantFontSize 11
skinparam sequenceParticipantBackgroundColor white
skinparam sequenceParticipantBorderColor #777777
skinparam sequenceLifeLineBorderColor #999999
skinparam sequenceLifeLineBackgroundColor white
skinparam sequenceActivationBorderColor #777777
skinparam sequenceActivationBackgroundColor white
skinparam sequenceActivationBorderThickness 0.5
skinparam sequenceGroupBorderThickness 0.6
skinparam sequenceGroupFontSize 10
skinparam maxMessageSize 290
autonumber

actor "Notification Event / Retry Worker" as User
participant "NotificationListener" as C
participant "NotificationService" as S
participant "ContactDirectoryPort" as P
participant "EmailPort" as E
participant "NotificationRepository" as R
participant "Database" as DB
User -> C ++: deliverEmail(request)
C -> C: resolveExecutionContext()
C -> S ++: deliverEmail(request, context)
S -> P ++: resolveAuthorizedContact(req)
P --> S --: configuredContact / invalid

alt permittedRecipientAndContact
  S -> S: buildMinimalSafeTemplate(req)
S -> E ++: sendMinimalEmail(req)
E --> S --: sent / providerFailure

else missingOrUnauthorizedContact
  S -> S: rejectEmailDisclosure()
end
S -> R ++: saveDeliveryOutcome(req)
R -> DB ++: SAVE delivery result + safe retry reference; COMMIT
DB --> R --: rows / committed result
R --> S --: deliveryRecorded

opt retryableDelivery
S -> P ++: resolveAuthorizedContact(req)
P --> S --: currentPermittedContact / denied
S -> E ++: retryDeliveryOnly(req)
E --> S --: deliveryOutcome
end
S --> C --: EmailDeliveryResult / controlled error
C --> User --: processing result / acknowledgment
@enduml
