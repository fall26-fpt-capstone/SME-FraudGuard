@startuml
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam ArrowThickness 1
skinparam classAttributeIconSize 0
skinparam classBackgroundColor white
skinparam classBorderColor #777777
skinparam classBorderThickness 1
skinparam classFontSize 12
skinparam classAttributeFontSize 11
skinparam stereotypeFontSize 10
skinparam Padding 4
hide circle
skinparam sequenceMessageAlign left
skinparam sequenceMessageFontSize 11
skinparam sequenceParticipantFontSize 11
skinparam sequenceParticipantBackgroundColor white
skinparam sequenceParticipantBorderColor #777777
skinparam sequenceLifeLineBorderColor #999999
skinparam sequenceLifeLineBackgroundColor white
skinparam sequenceActivationBorderColor #777777
skinparam sequenceActivationBackgroundColor white
skinparam sequenceActivationBorderThickness 0.5
skinparam sequenceGroupBorderThickness 0.6
skinparam sequenceGroupFontSize 10
skinparam maxMessageSize 290
autonumber

actor "Authorized Setup Actor" as User
participant "Onboarding Page" as UI
participant "OnboardingController" as C
participant "OnboardingService" as S
participant "DocumentStoragePort" as P
participant "OnboardingRepository" as R
participant "Database" as DB
User -> UI ++: submit(request)
UI -> C ++: maintainSpecifications(request)
C -> C: resolveExecutionContext()
C -> S ++: maintainSpecifications(request, context)
S -> S: authorizeSetupScope(ctx)
S -> R ++: findProgressAndSpecifications(req, ctx)
R -> DB ++: SELECT specifications, Staff and onboarding events\nWHERE authorized workspace
DB --> R --: rows / committed result
R --> S --: onboardingDetail

opt specificationUpdateRequested
  S -> S: validateDocumentAndSpecifications(req)
S -> P ++: storeProtectedDocument(req)
P --> S --: protectedDocumentRef
S -> R ++: saveSpecificationsWithHistory(req, ctx)
R -> DB ++: INSERT/UPDATE specification references + attribution; COMMIT
DB --> R --: rows / committed result
R --> S --: saved / failed
end
S --> C --: OnboardingResponse / controlled error
C --> UI --: OnboardingResponse / safe error
UI --> User --: render permitted result
@enduml
