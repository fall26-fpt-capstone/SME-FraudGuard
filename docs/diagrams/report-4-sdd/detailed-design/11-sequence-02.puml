@startuml
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam ArrowThickness 1
skinparam classAttributeIconSize 0
skinparam classBackgroundColor white
skinparam classBorderColor #777777
skinparam classBorderThickness 1
skinparam classFontSize 12
skinparam classAttributeFontSize 11
skinparam stereotypeFontSize 10
skinparam Padding 4
hide circle
skinparam sequenceMessageAlign left
skinparam sequenceMessageFontSize 11
skinparam sequenceParticipantFontSize 11
skinparam sequenceParticipantBackgroundColor white
skinparam sequenceParticipantBorderColor #777777
skinparam sequenceLifeLineBorderColor #999999
skinparam sequenceLifeLineBackgroundColor white
skinparam sequenceActivationBorderColor #777777
skinparam sequenceActivationBackgroundColor white
skinparam sequenceActivationBorderThickness 0.5
skinparam sequenceGroupBorderThickness 0.6
skinparam sequenceGroupFontSize 10
skinparam maxMessageSize 290
autonumber

actor "Operator / Investigator" as User
participant "Cases and Assignment Page" as UI
participant "CaseController" as C
participant "CaseService" as S
participant "CaseRepository" as R
participant "Database" as DB
User -> UI ++: submit(request)
UI -> C ++: readOrAssignCase(request)
C -> C: resolveExecutionContext()
C -> S ++: readOrAssignCase(request, context)
S -> S: authorizeCaseScope(ctx)
S -> R ++: findAuthorizedCases(req, ctx)
R -> DB ++: SELECT protected cases\nWHERE Operator workspace or current Investigator assignment
DB --> R --: rows / committed result
R --> S --: casePage

opt assignmentOrSelfInvestigationRequested
  S -> S: requireOperatorAndEligibleAssignee(req, ctx)
  S -> S: requireOpenOrActiveCurrentCase(req)
S -> R ++: assignCaseIfCurrent(req, ctx)
R -> DB ++: SAVE assignment + history; first start Open -> Investigating\nReassignment retains active/review state; COMMIT
DB --> R --: rows / committed result
R --> S --: currentResponsibility / stale

end
S --> C --: CaseResponse / controlled error
C --> UI --: CaseResponse / safe error
UI --> User --: render permitted result
@enduml
