@startuml
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam ArrowThickness 1
skinparam classAttributeIconSize 0
skinparam classBackgroundColor white
skinparam classBorderColor #777777
skinparam classBorderThickness 1
skinparam classFontSize 12
skinparam classAttributeFontSize 11
skinparam stereotypeFontSize 10
skinparam Padding 4
hide circle
skinparam sequenceMessageAlign left
skinparam sequenceMessageFontSize 11
skinparam sequenceParticipantFontSize 11
skinparam sequenceParticipantBackgroundColor white
skinparam sequenceParticipantBorderColor #777777
skinparam sequenceLifeLineBorderColor #999999
skinparam sequenceLifeLineBackgroundColor white
skinparam sequenceActivationBorderColor #777777
skinparam sequenceActivationBackgroundColor white
skinparam sequenceActivationBorderThickness 0.5
skinparam sequenceGroupBorderThickness 0.6
skinparam sequenceGroupFontSize 10
skinparam maxMessageSize 290
autonumber

actor "SME Admin / Operator" as User
participant "Report Generation and Export Page" as UI
participant "ReportingController" as C
participant "ReportingService" as S
participant "ReportingQueryPort" as P
participant "ReportRepository" as R
participant "Database" as DB
User -> UI ++: submit(request)
UI -> C ++: generateAndExport(request)
C -> C: resolveExecutionContext()
C -> S ++: generateAndExport(request, context)
S -> S: authorizeGenerationCriteria(req, ctx)
S -> R ++: createReportOperation(req, ctx)
R -> DB ++: INSERT generation reference + validated criteria
DB --> R --: rows / committed result
R --> S --: operationRef
S -> P ++: queryAuthorizedReportData(req, ctx)
P --> S --: protectedReportData / failure
S -> R ++: completeReportOperation(req)
R -> DB ++: SAVE complete/empty report or explicit failed stage; COMMIT
DB --> R --: rows / committed result
R --> S --: generationResult

opt supportedExportRequested
  S -> S: recheckExportScope(req, ctx)
  S -> S: protectFieldsAndNeutralizeFormulas(req)
S -> R ++: saveCompleteExport(req, ctx)
R -> DB ++: INSERT complete protected export reference; COMMIT
DB --> R --: rows / committed result
R --> S --: artifactRef / failed

end
opt downloadRequested
  S -> S: recheckArtifactAccess(req, ctx)
  S -> S: serveOnlyCompleteAuthorizedArtifact(req)
end
S --> C --: ReportExportResponse / controlled error
C --> UI --: ReportExportResponse / safe error
UI --> User --: render permitted result
@enduml
