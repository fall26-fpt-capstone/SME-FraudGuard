@startuml
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam ArrowThickness 1
skinparam classAttributeIconSize 0
skinparam classBackgroundColor white
skinparam classBorderColor #777777
skinparam classBorderThickness 1
skinparam classFontSize 12
skinparam classAttributeFontSize 11
skinparam stereotypeFontSize 10
skinparam Padding 4
hide circle
skinparam sequenceMessageAlign left
skinparam sequenceMessageFontSize 11
skinparam sequenceParticipantFontSize 11
skinparam sequenceParticipantBackgroundColor white
skinparam sequenceParticipantBorderColor #777777
skinparam sequenceLifeLineBorderColor #999999
skinparam sequenceLifeLineBackgroundColor white
skinparam sequenceActivationBorderColor #777777
skinparam sequenceActivationBackgroundColor white
skinparam sequenceActivationBorderThickness 0.5
skinparam sequenceGroupBorderThickness 0.6
skinparam sequenceGroupFontSize 10
skinparam maxMessageSize 290
autonumber

actor "Business Action / Authorized Reader" as User
participant "Object History Page" as UI
participant "AuditController" as C
participant "AuditService" as S
participant "ObjectAccessPolicy" as P
participant "AuditRepository" as R
participant "Database" as DB
User -> UI ++: submit(request)
UI -> C ++: recordAndReadHistory(request)
C -> C: resolveExecutionContext()
C -> S ++: recordAndReadHistory(request, context)
opt validatedLocalBusinessAction
  S -> S: buildValueFreeAttribution(req, ctx)
S -> R ++: commitBusinessChangeAndAudit(req, ctx)
R -> DB ++: COMMIT local business change + required audit together\nROLLBACK both when required history fails
DB --> R --: rows / committed result
R --> S --: committed / rolledBack

end
opt objectHistoryRequested
S -> P ++: authorizeUnderlyingObjectHistory(req, ctx)
P --> S --: permittedScope / denied

  alt authorizedObjectScope
S -> R ++: findScopedHistory(req, ctx)
R -> DB ++: SELECT protected immutable attribution\nWHERE underlying administrative/case scope
DB --> R --: rows / committed result
R --> S --: auditPage

  else unauthorizedSearch
    S -> S: denyAuditRead()
  end
end
S --> C --: AuditResponse / controlled error
C --> UI --: AuditResponse / safe error
UI --> User --: render permitted result
@enduml
